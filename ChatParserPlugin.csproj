<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Pinned to C# 5 so the same .cs also loads directly via ACT's built-in compiler. -->
    <LangVersion>5</LangVersion>
    <AssemblyName>ChatParserPlugin</AssemblyName>
    <RootNamespace>ChatParser</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Only the plugin file: tests\ has its own project that compiles this same source. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ChatParserPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Advanced Combat Tracker">
      <HintPath>C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
